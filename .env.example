# ============================================================
# 월하연 환경변수 예시
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 넣으세요.
# .env.local 은 .gitignore 에 의해 GitHub에 올라가지 않습니다.
# 실제 key 값을 이 파일(.env.example)에 절대 적지 마세요.
# ============================================================

# Supabase 프로젝트 URL
# 위치: Supabase 대시보드 → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) key — 브라우저에 노출되어도 되는 key.
# RLS 때문에 이 key로는 어떤 테이블도 읽고 쓸 수 없습니다.
# (지금 단계에서는 사용하지 않지만 표준 구성으로 미리 정의)
# 위치: Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — 서버 전용. RLS를 우회하는 관리자 key.
# 절대로 NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트 코드에서
# 사용하면 안 됩니다. Vercel에는 환경변수로만 등록하세요.
# 위치: Settings → API → Project API keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ── 토스페이먼츠 (테스트 결제) ──────────────────────────────
# 개발자센터(developers.tosspayments.com) → 로그인 → API 키 메뉴에서
# '결제위젯 연동 키'의 테스트 키를 복사하세요.
# 테스트 키는 test_ck_ / test_sk_ 로 시작하며 실제 청구가 발생하지 않습니다.

# 클라이언트 키 (브라우저 노출 가능, test_ck_... )
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 시크릿 키 (서버 전용! test_sk_... — 절대 NEXT_PUBLIC_ 금지)
TOSS_SECRET_KEY=

# ── Anthropic (리추얼 AI 생성) ─────────────────────────────
# console.anthropic.com → API Keys 에서 발급. 서버 전용.
ANTHROPIC_API_KEY=

# 선택: 사용할 모델 ID를 바꾸고 싶을 때만 설정 (기본값: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# ── 생성 API 보호용 관리자 시크릿 ───────────────────────────
# 아무나 주문번호만 알고 생성 API를 호출해 AI 비용을 발생시키지
# 못하게 막는 비밀값. 16자 이상의 무작위 문자열을 직접 만들어 넣으세요.
# (예: 비밀번호 생성기로 만든 32자 문자열)
RITUAL_ADMIN_SECRET=

# ── Resend (결과 이메일 발송) ───────────────────────────────
# resend.com → API Keys 에서 발급. 서버 전용.
RESEND_API_KEY=
# 발신 주소 (Resend에서 도메인 Verified 필요)
RESEND_FROM_EMAIL=letter@thewolha.com
# 결과 링크에 사용할 서비스 주소 (https, 슬래시 없이)
SITE_URL=https://thewolha.com
